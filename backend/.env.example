# ============ C-Diab backend configuration ============  (copy to .env; never commit .env)
# development | test | preview | production.  PRODUCTION REFUSES TO START with demo AI, mock payments, local storage,
# SQLite, demo eligibility, or a missing Supabase URL.
APP_ENV=development

# Database. Production: the Supabase Postgres connection string (server side only).
DATABASE_URL=sqlite:///./cdiab_dev.db

# ---- Supabase (server side only; NEVER put the service-role key in the mobile app) ----
SUPABASE_URL=
SUPABASE_JWT_SECRET=            # legacy HS256 projects only. Leave empty if your project uses asymmetric JWT signing keys (JWKS).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screening-images
STORAGE_BACKEND=local           # local (dev) | supabase (required in production)
LOCAL_STORAGE_DIR=./.local_storage
MAX_IMAGE_BYTES=8388608

# ---- AI ----
AI_BACKEND=demo                 # demo (dev/preview only, always labelled) | http (validated model service)
MODEL_SERVICE_URL=
MODEL_SERVICE_TOKEN=
DEMO_FORCE_OUTCOME=             # dev only: none | superficial | deep | undetermined  (forces the demo result)
QUALITY_MIN_BLUR=25             # photo sharpness gate; calibrate with real photos

# ---- Eligibility policy ----
POLICY_CONFIG_PATH=policy/policy.default.json   # strict draft. policy/policy.demo.json is refused outside development/test
ALLOW_DEMO_ELIGIBILITY=false    # dev only: lets a DEMO result unlock checkout so the whole flow can be shown

# ---- Payments ----
PAYMENT_PROVIDER=mock           # mock (dev only) | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPPING_FLAT_PAISE=9900
FREE_SHIPPING_THRESHOLD_PAISE=199900

RATE_LIMIT_ENABLED=true
CORS_ORIGINS=[]
